# Docker Compose build-time variables. Copy to .env and adjust.
# These control the compose stack at the host/network level. Runtime
# configuration of the demo app itself lives in demo/.env (see demo/.env.example).

# Host port the demo HTTP server is published on (default 3000). This is also
# the container's fixed listen port: the demo app's own PORT value (see
# demo/.env.example) applies to native runs but is overridden to match the
# published port inside the compose stack.
# DEMO_PORT=3000

# Host port Prometheus is published on (default 9090).
# PROMETHEUS_PORT=9090

# Redis connection string as seen from inside the compose network.
# REDIS_URL=redis://redis:6379
