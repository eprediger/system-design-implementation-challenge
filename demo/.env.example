# Demo runtime configuration (process-level).
# Copy to .env and adjust. Values are validated at startup; invalid values
# abort the demo with a clear message. All vars are optional.

# HTTP listen port.
# PORT=3000

# Redis connection. When empty/unset the demo uses an in-memory store with no
# fault tolerance. Must be a redis:// or rediss:// URL.
# REDIS_URL=redis://127.0.0.1:6379

# Trust X-Forwarded-For from any hop. Default false: only loopback clients can
# set X-Forwarded-For, so remote callers cannot spoof per-IP limits.
# TRUST_PROXY=false

# pino log level: trace|debug|info|warn|error|fatal|silent.
# LOG_LEVEL=info

# Fail-open circuit (only used when REDIS_URL is set):
# consecutive primary failures before the circuit opens.
# FAILOVER_THRESHOLD=3
# ms to wait before the half-open probe.
# FAILOVER_RECOVERY_MS=30000
# consecutive half-open successes before the circuit re-seats on the primary.
# FAILOVER_SUCCESS_THRESHOLD=1
